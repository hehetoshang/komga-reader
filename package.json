{
  "name": "@hehetoshang/komga-reader",
  "version": "0.1.0",
  "description": "Standalone Vue 3 comic image reader extracted from Komga",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/komga-reader.cjs",
  "module": "./dist/komga-reader.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/komga-reader.js",
      "require": "./dist/komga-reader.cjs"
    },
    "./style.css": "./dist/komga-reader.css"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepare": "npm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:demo"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hehetoshang/komga-reader.git"
  },
  "homepage": "https://github.com/hehetoshang/komga-reader#readme"
}
